#!/usr/bin/env bash
# Runs the same checks as CI before allowing a push.
# Enable once per clone: git config core.hooksPath .githooks
# Skip one-off:          git push --no-verify

set -e

if ! command -v nox >/dev/null 2>&1; then
    echo "pre-push: nox not found. Install with: pip install nox" >&2
    exit 1
fi

echo "pre-push: running nox (tests + docs)..."
nox
